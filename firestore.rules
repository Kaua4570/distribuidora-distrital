rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNÇÕES AUXILIARES
    // ============================================================

    // Logado no Firebase Authentication?
    function logado() {
      return request.auth != null;
    }

    // Logado E com documento ativo em usuarios_autorizados/{uid}?
    function autorizado() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid)).data.ativo == true;
    }

    // Administrador: autorizado E com admin == true no próprio documento de autorização.
    // (admin só pode ser definido pelo Console do Firebase, pois usuarios_autorizados é imutável pelo app.)
    function admin() {
      return autorizado()
        && get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // Tipo de acesso gravado pelo painel: cliente | entregador | comanda.
    // (sem tipo = cliente, para logins antigos que já existiam.)
    function tipoDoUsuario() {
      return get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid)).data.get('tipo', '');
    }
    function cliente() {
      return autorizado() && (admin() || tipoDoUsuario() in ['cliente', '']);
    }
    function entregador() {
      return autorizado() && tipoDoUsuario() == 'entregador';
    }
    function comanda() {
      return autorizado() && tipoDoUsuario() == 'comanda';
    }
    // Quem enxerga e atualiza todos os pedidos
    function equipe() {
      return admin() || comanda();
    }

    // Dados de um login liberado pelo painel (admin só pelo Console).
    function usuarioValido() {
      let d = request.resource.data;
      return d.ativo is bool
        && d.get('tipo', 'cliente') in ['cliente', 'entregador', 'comanda']
        && d.get('admin', false) != true
        && d.get('nome', '') is string && d.get('nome', '').size() <= 80;
    }

    // Pedido novo feito por um cliente no catálogo reservado.
    function pedidoNovoValido() {
      let d = request.resource.data;
      return d.clienteUid == request.auth.uid
        && d.cliente is string && d.cliente.size() > 0 && d.cliente.size() <= 80
        && d.telefone is string && d.telefone.size() >= 8 && d.telefone.size() <= 20
        && d.endereco is string && d.endereco.size() > 0 && d.endereco.size() <= 400
        && d.pagamento in ['Pix', 'Dinheiro']
        && d.get('troco', '') is string && d.get('troco', '').size() <= 30
        && d.pago == false
        && d.status == 'Pendente'
        && d.total is number && d.total >= 0
        && d.itens is list && d.itens.size() > 0 && d.itens.size() <= 100
        && (d.get('localizacao', null) == null
            || (d.localizacao.lat is number && d.localizacao.lng is number))
        && d.criadoEm == request.time;
    }

    // O entregador só mexe em: entregadorUid, status e entregueEm — e só em
    // pedido que ainda não é de outro entregador nem está encerrado.
    function entregadorAtualizaRota() {
      let antes = resource.data;
      let depois = request.resource.data;
      return entregador()
        && depois.diff(antes).affectedKeys().hasOnly(['entregadorUid', 'status', 'entregueEm'])
        && depois.entregadorUid == request.auth.uid
        && (!('entregadorUid' in antes) || antes.entregadorUid == request.auth.uid)
        && antes.status != 'Finalizado' && antes.status != 'Cancelado'
        && depois.status in ['Saiu para Entrega', 'Chegando', 'Finalizado'];
    }

    // Validação dos dados de produto da tela secreta.
    function produtoValido() {
      let d = request.resource.data;
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.categoriaId is string && d.categoriaId.size() > 0 && d.categoriaId.size() <= 120
        && d.preco is number && d.preco >= 0
        && d.get('volume', '') is string && d.get('volume', '').size() <= 200
        && d.get('descricao', '') is string && d.get('descricao', '').size() <= 1000
        && d.get('imagemUrl', '') is string && d.get('imagemUrl', '').size() <= 700000
        && d.get('disponivel', true) is bool
        && d.get('visivel', true) is bool;
    }

    // Validação mais folgada para a tela inicial: produtos antigos (importados do backup)
    // podem ter categoria vazia ou foto grande, e ainda assim precisam poder ser reordenados.
    function produtoPublicoValido() {
      let d = request.resource.data;
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 120
        && d.preco is number && d.preco >= 0
        && d.get('categoriaId', '') is string
        && d.get('disponivel', true) is bool
        && d.get('visivel', true) is bool;
    }

    // Validação de categoria.
    function categoriaValida() {
      let d = request.resource.data;
      return d.nome is string && d.nome.size() > 0 && d.nome.size() <= 60
        && d.get('ordem', 0) is number;
    }

    // ============================================================
    // TELA INICIAL (cardápio público)
    //  - ler: qualquer pessoa
    //  - gravar: somente administrador (painel aberto pela engrenagem)
    // ============================================================
    match /produtos/{id} {
      allow read: if true;
      allow create, update: if admin() && produtoPublicoValido();
      allow delete: if admin();
    }
    match /categorias/{id} {
      allow read: if true;
      allow create, update: if admin() && categoriaValida();
      allow delete: if admin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // ============================================================
    // PEDIDOS DE ENTREGA (feitos no catálogo reservado)
    //  - o código do pedido (ID do documento) vem de um contador sequencial
    //  - cliente: cria e lê só os próprios pedidos
    //  - entregador: lê pelo número (get) e entra na própria rota; lista só a rota dele
    //  - admin / comanda: leem e atualizam tudo; só admin apaga
    // ============================================================
    match /pedidos/{id} {
      allow get: if equipe() || entregador()
                 || (cliente() && resource.data.clienteUid == request.auth.uid);
      allow list: if equipe()
                  || (cliente() && resource.data.clienteUid == request.auth.uid)
                  || (entregador() && resource.data.entregadorUid == request.auth.uid);
      allow create: if cliente() && pedidoNovoValido();
      allow update: if equipe() || entregadorAtualizaRota();
      allow delete: if admin();
    }

    // Contador do número do pedido: só sobe de 1 em 1.
    match /contadores/{id} {
      allow get: if cliente();
      allow create: if cliente() && id == 'pedidos' && request.resource.data.valor == 1;
      allow update: if cliente() && id == 'pedidos'
                    && request.resource.data.valor == resource.data.valor + 1;
    }

    // ============================================================
    // TELA SECRETA
    // ============================================================

    // UIDs autorizados (logins liberados).
    //  - Cada usuário lê o PRÓPRIO documento (o app descobre o tipo de acesso).
    //  - O admin lista, libera, troca o tipo, bloqueia e remove os outros pelo painel.
    //  - Ninguém concede "admin" pelo app: isso só pelo Console do Firebase.
    //  - O admin não altera o próprio documento nem o de outro admin.
    match /usuarios_autorizados/{uid} {
      allow get: if logado() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if admin() && uid != request.auth.uid && usuarioValido();
      allow update: if admin() && uid != request.auth.uid
                    && resource.data.get('admin', false) != true && usuarioValido();
      allow delete: if admin() && uid != request.auth.uid
                    && resource.data.get('admin', false) != true;
    }

    // Produtos secretos:
    //  - ler: qualquer usuário autorizado e ativo
    //  - criar/editar/excluir: somente administradores (e com dados válidos)
    match /produtos_secretos/{id} {
      allow get, list: if autorizado();
      allow create, update: if admin() && produtoValido();
      allow delete: if admin();
    }

    // Categorias da tela secreta (mesma ferramenta do painel).
    match /categorias_secretas/{id} {
      allow get, list: if autorizado();
      allow create, update: if admin() && categoriaValida();
      allow delete: if admin();
    }

    // Qualquer outro caminho não listado acima continua NEGADO por padrão.
  }
}
