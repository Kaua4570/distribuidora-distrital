rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // ÁREA PÚBLICA E PAINEL ATUAL — IDÊNTICO ao que já estava em uso.
    // (Mantido aberto para não quebrar o site e o admin.html atuais,
    //  que ainda não usam Firebase Authentication. Veja o aviso no README.)
    // ============================================================
    match /produtos/{id}     { allow read: if true; allow write: if true; }
    match /categorias/{id}   { allow read: if true; allow write: if true; }
    match /pedidos/{id}      { allow read: if true; allow create: if true; allow update, delete: if true; }
    match /config/{id}       { allow read: if true; allow write: if true; }

    // ============================================================
    // ÁREA SECRETA
    // ============================================================

    // Logado no Firebase Authentication?
    function logado() {
      return request.auth != null;
    }

    // Logado E com documento ativo em usuarios_autorizados/{uid}?
    function autorizado() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios_autorizados/$(request.auth.uid)).data.ativo == true;
    }

    // UIDs autorizados.
    //  - Cada usuário só consegue LER o próprio documento (para o app saber se foi liberado).
    //  - Ninguém consegue listar, criar, alterar ou apagar pelo app/cliente:
    //    quem concede acesso é o responsável, direto no Console do Firebase
    //    (o Console ignora estas regras).
    match /usuarios_autorizados/{uid} {
      allow get: if logado() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Produtos secretos: só leitura, só para autenticados E autorizados.
    // Escrita bloqueada para qualquer cliente (cadastre pelo Console do Firebase).
    match /produtos_secretos/{id} {
      allow get, list: if autorizado();
      allow create, update, delete: if false;
    }

    // Qualquer outro caminho não listado acima continua NEGADO por padrão.
  }
}
