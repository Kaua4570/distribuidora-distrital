{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "app.js", "use": "@vercel/static" },
    { "src": "firebase-config.js", "use": "@vercel/static" },
    { "src": "style.css", "use": "@vercel/static" },
    { "src": "pin.js", "use": "@vercel/node" },
    { "src": "pix.js", "use": "@vercel/node" },
    { "src": "webhook.js", "use": "@vercel/node" },
    { "src": "create-user.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/pin", "dest": "/pin.js" },
    { "src": "/api/pix", "dest": "/pix.js" },
    { "src": "/api/webhook", "dest": "/webhook.js" },
    { "src": "/api/create-user", "dest": "/create-user.js" },
    { "handle": "filesystem" },
    { "src": "/", "dest": "/index.html" }
  ]
}
